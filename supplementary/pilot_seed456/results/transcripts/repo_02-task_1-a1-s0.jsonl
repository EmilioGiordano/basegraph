{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CS1c7saPeRRBpPygbwrpeC","type":"tool_result","content":"1\t//! Delivery promises: lead time by route length and priority.\n2\t\n3\t// NOTE: keep the public surface of logistics stable; the ops tooling links against it.\n4\t// TODO: revisit the naming in this file once the workspace split lands.\n5\t// Reviewed in the quarterly hardening pass; no functional findings.\n6\t// Style: prefer early returns in new helpers here, matching the rest of the crate.\n7\t\n8\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n9\tpub enum Priority {\n10\t    Standard,\n11\t    Express,\n12\t}\n13\t\n14\tpub const KM_PER_DAY: u32 = 400;\n15\t\n16\t/// Promised lead time in days for a route.\n17\tpub fn lead_time_days(route_km: u32, priority: Priority) -> i64 {\n18\t    let base = (route_km / KM_PER_DAY) as i64 + 2;\n19\t    let days = match priority {\n20\t        Priority::Standard => base,\n21\t        Priority::Express => base - 2,\n22\t    };\n23\t    days.max(1)\n24\t}\n25\t\n26\t#[cfg(test)]\n27\tmod tests {\n28\t    use super::*;\n29\t\n30\t    #[test]\n31\t    fn standard_routes_add_handling_days() {\n32\t        assert_eq!(lead_time_days(1200, Priority::Standard), 5);\n33\t    }\n34\t\n35\t    #[test]\n36\t    fn express_skips_handling() {\n37\t        assert_eq!(lead_time_days(1200, Priority::Express), 3);\n38\t    }\n39\t\n40\t    #[test]\n41\t    fn short_express_routes_promise_next_day() {\n42\t        assert_eq!(lead_time_days(100, Priority::Express), 1);\n43\t    }\n44\t}\n45\t"}]},"parent_tool_use_id":null,"session_id":"d36f2b31-92de-49d9-ab11-46f4a1f0ff2f","uuid":"ed9bdc97-dddd-4e64-aa0d-5cadd48160b4","timestamp":"2026-08-31T18:55:58.787Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\giord\\Desktop\\dashboard\\pilot2_work\\repo_02-task_1-a1-s0\\src\\logistics.rs","content":"//! Delivery promises: lead time by route length and priority.\n\n// NOTE: keep the public surface of logistics stable; the ops tooling links against it.\n// TODO: revisit the naming in this file once the workspace split lands.\n// Reviewed in the quarterly hardening pass; no functional findings.\n// Style: prefer early returns in new helpers here, matching the rest of the crate.\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Priority {\n    Standard,\n    Express,\n}\n\npub const KM_PER_DAY: u32 = 400;\n\n/// Promised lead time in days for a route.\npub fn lead_time_days(route_km: u32, priority: Priority) -> i64 {\n    let base = (route_km / KM_PER_DAY) as i64 + 2;\n    let days = match priority {\n        Priority::Standard => base,\n        Priority::Express => base - 2,\n    };\n    days.max(1)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn standard_routes_add_handling_days() {\n        assert_eq!(lead_time_days(1200, Priority::Standard), 5);\n    }\n\n    #[test]\n    fn express_skips_handling() {\n        assert_eq!(lead_time_days(1200, Priority::Express), 3);\n    }\n\n    #[test]\n    fn short_express_routes_promise_next_day() {\n        assert_eq!(lead_time_days(100, Priority::Express), 1);\n    }\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
